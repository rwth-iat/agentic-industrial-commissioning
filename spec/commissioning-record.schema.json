{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-industrial-commissioning:schema:commissioning-record:0.1.0",
  "title": "Commissioning Run Record",
  "description": "Small private evidence records for one component-scoped commissioning run. This is an execution-evidence contract, not a fifth plant knowledge model.",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "case_id",
    "asset_id",
    "requested_interface",
    "created_at",
    "data_classification"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_type": {
      "enum": [
        "run_manifest",
        "preflight",
        "execution_record"
      ]
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "case_id": {
      "$ref": "#/$defs/id"
    },
    "asset_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "requested_interface": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "data_classification": {
      "const": "private"
    },
    "repository_revision": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "connection_profile": {
      "$ref": "#/$defs/id"
    },
    "input_contracts": {
      "$ref": "#/$defs/contractRevisions"
    },
    "safety_boundary": {
      "$ref": "#/$defs/safetyBoundary"
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "raw_evidence_refs": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "assessment": {
      "$ref": "#/$defs/assessment"
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "writes_observed": {
      "const": false
    },
    "input_revisions": {
      "$ref": "#/$defs/contractRevisions"
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "#/$defs/timestamp"
    },
    "initial_state": {
      "$ref": "#/$defs/state"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "timeouts": {
      "$ref": "#/$defs/timeouts"
    },
    "human_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/humanObservation"
      }
    },
    "restore": {
      "$ref": "#/$defs/restore"
    },
    "final_state": {
      "$ref": "#/$defs/state"
    },
    "execution_status": {
      "enum": [
        "succeeded",
        "aborted",
        "failed"
      ]
    },
    "resulting_assessment": {
      "$ref": "#/$defs/assessment"
    },
    "adapter_ref": {
      "$ref": "#/$defs/nonEmptyString"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "record_type": {
          "const": "run_manifest"
        }
      },
      "required": [
        "repository_revision",
        "connection_profile",
        "input_contracts",
        "safety_boundary"
      ]
    },
    {
      "properties": {
        "record_type": {
          "const": "preflight"
        }
      },
      "required": [
        "observed_at",
        "raw_evidence_refs",
        "checks",
        "hypotheses",
        "assessment",
        "blockers",
        "writes_observed"
      ]
    },
    {
      "properties": {
        "record_type": {
          "const": "execution_record"
        }
      },
      "required": [
        "input_revisions",
        "started_at",
        "finished_at",
        "initial_state",
        "approval",
        "events",
        "timeouts",
        "human_observations",
        "restore",
        "hypotheses",
        "final_state",
        "execution_status",
        "resulting_assessment"
      ]
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "assessment": {
      "enum": [
        "hard_blocked",
        "ready_for_supervised_probe",
        "validated_interface"
      ]
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "contractRevision": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "revision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "hardware_model",
            "software_model",
            "implementation_links",
            "runtime_bindings"
          ]
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "contractRevisions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/contractRevision"
      }
    },
    "safetyBoundary": {
      "type": "object",
      "required": [
        "mode",
        "state_changes_authorized"
      ],
      "properties": {
        "mode": {
          "const": "read_only_preflight"
        },
        "state_changes_authorized": {
          "const": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "untested",
            "confirmed",
            "refuted"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "blocker": {
      "type": "object",
      "required": [
        "code",
        "description",
        "required_evidence_or_mitigation",
        "reevaluation_condition"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "required_evidence_or_mitigation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reevaluation_condition": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "approval": {
      "type": "object",
      "required": [
        "approved_at",
        "scope",
        "maximum_duration_seconds",
        "restore_target"
      ],
      "properties": {
        "approved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "maximum_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "restore_target": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_ref": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "timestamp",
        "kind",
        "outcome"
      ],
      "properties": {
        "timestamp": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "enum": [
            "read",
            "write",
            "runtime_observation",
            "timeout",
            "error",
            "abort",
            "restore"
          ]
        },
        "binding_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "value": {},
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "observed"
          ]
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "raw_evidence_ref": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "read",
              "write"
            ]
          }
        }
      },
      "then": {
        "required": [
          "binding_id"
        ]
      }
    },
    "timeouts": {
      "type": "object",
      "required": [
        "overall_seconds",
        "triggered"
      ],
      "properties": {
        "overall_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "triggered": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "humanObservation": {
      "type": "object",
      "required": [
        "timestamp",
        "observation"
      ],
      "properties": {
        "timestamp": {
          "$ref": "#/$defs/timestamp"
        },
        "observation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_ref": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "restore": {
      "type": "object",
      "required": [
        "attempted",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "attempted": {
          "const": true
        },
        "status": {
          "enum": [
            "verified",
            "failed",
            "unknown"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
